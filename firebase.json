{
  "firestore": {
    "database": "ai-studio-b43aca98-7cce-4bbc-aab1-f30f0287b065",
    "rules": "firestore.rules"
  },
  "storage": {},
  "hosting": [
    {
      "site": "gen-lang-client-0409964320",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.woff2",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}